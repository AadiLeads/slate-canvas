# OpenRouter API key — get one at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=YOUR OPEN ROUTER API KEY
# Model to use (must be multimodal). Free options:
#   google/gemini-2.0-flash-exp:free
#   google/gemini-flash-1.5-8b
#   meta-llama/llama-3.2-11b-vision-instruct:free
VITE_AI_MODEL= google/gemma-4-26b-a4b-it:free

# Max output tokens
VITE_AI_MAX_TOKENS=1500

# Config ID used in trace records (change per experiment arm)
VITE_AI_CONFIG_ID=cfg_default
